#note put this on .ENV of the backend.

#-----------------------------------------------------------------
# APPLICATION
#-----------------------------------------------------------------
APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:bdpSdp44vdnUm1Lw6+I+LQZxjNPtMtQK+eT9aS+LLQk=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_SUPPORTS_CREDENTIALS=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

#-----------------------------------------------------------------
# SECURITY / ENCRYPTION
#-----------------------------------------------------------------
BCRYPT_ROUNDS=12

#-----------------------------------------------------------------
# DATABASE
#-----------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=balbuena
DB_USERNAME=root
DB_PASSWORD=

#-----------------------------------------------------------------
# SESSION (not required for API tokens)
#-----------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

#-----------------------------------------------------------------
# SANCTUM (for SPA with cookies, empty for token-based REST API)
#-----------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173

#-----------------------------------------------------------------
# CACHE & QUEUE
#-----------------------------------------------------------------
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

#-----------------------------------------------------------------
# REDIS / MEMCACHED (optional)
#-----------------------------------------------------------------
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#-----------------------------------------------------------------
# MAIL (logs emails locally)
#-----------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
